{
  "name": "seqvio",
  "version": "0.7.0",
  "seqvio": {
    "lifecycle": "internal",
    "releaseTrain": "0.7"
  },
  "private": true,
  "description": "A visual language for coding agents to explain ideas with narrated video",
  "keywords": [
    "explainer-video",
    "video",
    "react",
    "animation",
    "narration",
    "whiteboard-animation",
    "programmatic-video",
    "ai-agent",
    "agent-skill"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/makesynt/seqvio.git"
  },
  "license": "MIT",
  "author": "Seqvio Team",
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "@ffmpeg-installer/darwin-arm64@4.1.5": true,
    "@ffmpeg-installer/darwin-x64@4.1.0": true,
    "@ffmpeg-installer/linux-arm@4.1.3": true,
    "@ffmpeg-installer/linux-arm64@4.1.4": true,
    "@ffmpeg-installer/linux-ia32@4.1.0": true,
    "@ffmpeg-installer/linux-x64@4.1.0": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true,
    "puppeteer@22.15.0": true,
    "puppeteer@25.1.0": true
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --include-workspace-root=false",
    "build": "npm run build -w @seqvio/core && npm run build -w @seqvio/capture && npm run build -w @seqvio/whiteboard && npm run build -w @seqvio/scatterbrain && npm run build -w @seqvio/product-demo && npm run build -w @seqvio/technical && npm run build -w @seqvio/renderer && npm run build -w @seqvio/browser-recorder && npm run build -w @seqvio/terminal-narrator",
    "test": "npm run test --workspaces --if-present --include-workspace-root=false",
    "test:browser": "npm run test:browser -w @seqvio/renderer",
    "test:conformance": "npm run test:browser -w @seqvio/renderer",
    "smoke:release-pipeline": "node scripts/release-pipeline-smoke.mjs",
    "smoke:release-pipeline:terminal": "node scripts/release-pipeline-smoke.mjs --kind terminal",
    "smoke:release-pipeline:browser": "node scripts/release-pipeline-smoke.mjs --kind browser",
    "verify:capture-host": "node scripts/verify-capture-host.mjs",
    "smoke:capture-host-runtime": "node scripts/capture-host-runtime-smoke.mjs",
    "prepare:native": "node scripts/prepare-native-dependencies.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "doctor": "node packages/renderer/dist/doctor-cli.js",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "node scripts/visual-regression.mjs --update",
    "benchmark:render": "node scripts/render-benchmark.mjs",
    "benchmark:render:check": "node scripts/render-benchmark.mjs --check",
    "benchmark:render:update": "node scripts/render-benchmark.mjs --update-baseline",
    "audio:technical-explainer": "node scripts/technical-explainer-audio-loop.mjs",
    "smoke:terminal:native": "node packages/terminal-narrator/dist/cli.js record --sample --outputDir temp/terminal-smoke-native",
    "smoke:terminal:claude": "node packages/terminal-narrator/dist/cli.js record --sample-claude --skill /help --outputDir temp/terminal-smoke-claude",
    "lint": "npm run lint --workspaces --if-present --include-workspace-root=false",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "npm run clean --workspaces --if-present --include-workspace-root=false",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && npm run verify:contracts && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "puppeteer": "^25.1.0",
    "xterm": "^5.3.0"
  }
}
