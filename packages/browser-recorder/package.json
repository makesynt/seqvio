{
  "name": "@seqvio/browser-recorder",
  "version": "0.2.1",
  "description": "Pre-stable browser capture-to-explanation adapter for Seqvio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seqvio-recorder": "dist/cli.js",
    "seqvio-browser-recorder": "dist/cli.js",
    "seqvio-browser": "dist/cli.js"
  },
  "seqvio": {
    "lifecycle": "experimental",
    "adapterLifecycle": "pre-stable",
    "versionPolicy": "independent",
    "cliContractVersion": "2.0",
    "artifactManifestVersion": "1.0"
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc",
    "prepack": "npm run build",
    "test": "node --test",
    "test:ui": "node scripts/ui-smoke.mjs",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@seqvio/capture": "0.2.1",
    "@seqvio/core": "0.7.1",
    "@seqvio/product-demo": "0.7.1",
    "@seqvio/renderer": "0.7.1",
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
