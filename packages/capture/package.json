{
  "name": "@seqvio/capture",
  "version": "0.2.1",
  "seqvio": {
    "lifecycle": "experimental",
    "versionPolicy": "independent"
  },
  "description": "Capture-session contract and manifest-to-ExplainerDocument compiler for Seqvio",
  "keywords": [
    "seqvio",
    "capture",
    "terminal",
    "browser",
    "agent",
    "video"
  ],
  "license": "MIT",
  "author": "Seqvio Team",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@seqvio/core": "0.7.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
