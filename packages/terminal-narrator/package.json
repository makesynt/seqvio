{
  "name": "@seqvio/terminal-narrator",
  "version": "0.3.0",
  "description": "Pre-stable terminal capture-to-explanation adapter for Seqvio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "seqvio-terminal-narrator": "dist/cli.js",
    "seqvio-terminal": "dist/cli.js"
  },
  "seqvio": {
    "lifecycle": "experimental",
    "adapterLifecycle": "pre-stable",
    "versionPolicy": "independent",
    "cliContractVersion": "1.0",
    "artifactManifestVersion": "1.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@seqvio/capture": "0.2.0",
    "@seqvio/core": "0.7.0",
    "@seqvio/renderer": "0.7.0",
    "@seqvio/technical": "0.7.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
