{
  "name": "@seqvio/product-demo",
  "version": "0.6.0",
  "description": "Product walkthrough components for Seqvio",
  "keywords": [
    "seqvio",
    "product-demo",
    "screencast",
    "walkthrough",
    "video",
    "react"
  ],
  "license": "MIT",
  "author": "Seqvio Team",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
