{
  "name": "@seqvio/technical",
  "version": "0.7.1",
  "seqvio": {
    "lifecycle": "public",
    "releaseTrain": "0.7"
  },
  "description": "Technical explainer components for Seqvio (code, diagrams, annotations)",
  "keywords": [
    "seqvio",
    "technical",
    "code-walkthrough",
    "architecture-diagram",
    "explainer",
    "video",
    "react"
  ],
  "license": "MIT",
  "author": "Seqvio Team",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/cascadia-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@seqvio/core": "0.7.1",
    "react": "^18.0.0 || ^19.0.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
